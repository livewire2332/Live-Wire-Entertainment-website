{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "live-wire-facebook-automation",
  "main": "./worker.js",
  "compatibility_date": "2026-09-16",
  "workers_dev": true,
  "vars": {
    "FACEBOOK_AUTOMATION_ENABLED": "false"
  },
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "keep_vars": true,
  "kv_namespaces": [
    {
      "binding": "FACEBOOK_TOKENS"
    }
  ]
}
